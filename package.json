{
  "name": "nova-pioneer-basketball",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next start",
    "postinstall": "prisma generate",
    "seed": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first tsx prisma/seed.ts",
    "db:push": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first prisma db push",
    "db:migrate": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "cross-env": "^7.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
