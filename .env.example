# PostgreSQL connection string from Render (Dashboard > your database > Connections > External/Internal URL)
DATABASE_URL="postgresql://user:password@host:5432/nova_pioneer"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Your deployed URL on Render, e.g. https://nova-pioneer.onrender.com
# Use http://localhost:3000 for local development
NEXTAUTH_URL="http://localhost:3000"
